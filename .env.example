# Initial development quotas. Tune after a local baseline run.
COORDINATOR_CPUS=0.5
COORDINATOR_MEMORY=4g
WORKER_CPUS=0.5
WORKER_MEMORY=4g
# The evaluation runner generates an isolated worker token for each run.

# Optional agent credentials. The evaluation harness injects only the key for
# the selected agent into that CLI process.
CODEX_API_KEY=
# Optional fallback name accepted by the Codex launcher.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
